  "spots": {
    "airport": {
      "label": "落地机场",
      "stk": "passport",
      "tips": [
        {
          "trap": "出租车不打表，或者开口一个高价",
          "do": "排官方出租车队并让司机打表；也可以用 Grab，或者提前在飞猪订接机"
        },
        {
          "trap": "有人主动用中文搭话，要帮你换钱、叫车、办电话卡",
          "do": "换钱去机场或市区的正规兑换点；电话卡在机场柜台或飞猪买"
        },
        {
          "trap": "入境时被抽查现金或材料",
          "do": "提前在 tdac.immigration.go.th 免费填好入境卡，带约 2 万泰铢现金或等值外币，打印酒店订单"
        }
      ],
      "say": [
        "meter",
        "go_hotel",
        "howmuch_here",
        "thanks"
      ]
    },
    "hotel": {
      "label": "酒店",
      "stk": "house",
      "tips": [
        {
          "trap": "出门后说不清酒店在哪",
          "do": "出门前打开这家酒店的「司机卡」，地图定位给司机看最稳"
        },
        {
          "trap": "陌生人推荐的「好店」「便宜团」",
          "do": "有需要先问酒店前台：叫车、问路、订活动都更靠谱"
        },
        {
          "trap": "护照和贵重物品随身乱放",
          "do": "护照放房间保险箱，身上带一张护照照片页的复印件或手机照片"
        }
      ],
      "say": [
        "have_booking",
        "check_in",
        "luggage",
        "call_taxi"
      ]
    },
    "temple": {
      "label": "寺庙",
      "stk": "temple",
      "tips": [
        {
          "trap": "门口有人说「今天关门了」，要带你去别的地方",
          "do": "这是经典骗局。直接走到正门看，不上陌生人帮你叫的嘟嘟车"
        },
        {
          "trap": "穿短裤、背心被拦在门口",
          "do": "穿过膝的裤子或裙子、遮住肩膀；进殿要脱鞋"
        },
        {
          "trap": "不小心冒犯",
          "do": "别摸别人的头，别用脚指佛像；女生不要碰僧人"
        }
      ],
      "say": [
        "ticket",
        "no_thanks",
        "go_myself",
        "toilet"
      ]
    },
    "market": {
      "label": "市场 / 夜市",
      "stk": "market",
      "tips": [
        {
          "trap": "没问价就买，结账时被要高价",
          "do": "先问价再买。市场可以讲价，商场不讲价"
        },
        {
          "trap": "人多的时候丢手机、丢包",
          "do": "包背在前面，手机别放后裤兜"
        },
        {
          "trap": "小摊只收现金",
          "do": "备一点零钱；很多摊位也能用支付宝、微信扫泰国二维码"
        }
      ],
      "say": [
        "howmuch",
        "cheaper",
        "not_spicy",
        "delicious"
      ]
    },
    "food": {
      "label": "吃饭",
      "stk": "padthai",
      "tips": [
        {
          "trap": "菜单没有标价",
          "do": "点菜前先看价格，或者直接问"
        },
        {
          "trap": "辣度超出预期",
          "do": "点菜时说「不要辣」"
        }
      ],
      "say": [
        "menu",
        "not_spicy",
        "delicious",
        "bill"
      ]
    },
    "transport": {
