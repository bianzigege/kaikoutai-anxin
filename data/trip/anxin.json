      "stk": "coconut",
      "tips": [
        {
          "trap": "还水上摩托、摩托车时，老板说你弄坏了要赔钱",
          "do": "租之前当着老板的面绕一圈拍视频；护照不押给对方"
        },
        {
          "trap": "风浪大还下水",
          "do": "听救生员的；海滩插红旗时不要下水"
        }
